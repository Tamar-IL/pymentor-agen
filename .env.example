# Copy this file to .env and fill in your own keys. NEVER commit the real .env file.

# --- OpenRouter (required) - get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- LangSmith monitoring (recommended) - get a key at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pymentor-agent

# --- Optional: model choice (defaults shown)
# PYMENTOR_MODEL=google/gemma-4-31b-it:free
# PYMENTOR_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free

# --- Optional: evals (the cost eval needs at least one paid model = a few cents of credit)
# EVAL_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# EVAL_PAID_MODELS=openai/gpt-4o-mini
# JUDGE_MODEL=openai/gpt-4o-mini
